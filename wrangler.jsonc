{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymflow-platform",

  // Entree personnalisee : elle enveloppe le worker genere par OpenNext pour
  // y adjoindre la classe Durable Object (voir worker.ts).
  "main": "worker.ts",

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Base de donnees centrale (plan de controle). UNE seule, donc un binding
  // statique convient : elle ne se multiplie pas avec les clubs.
  "d1_databases": [
    {
      "binding": "CONTROL",
      "database_name": "gymflow-control",
      // En local, wrangler cree une base SQLite dans .wrangler/ et ignore cet
      // identifiant : il ne sert qu'au deploiement.
      //
      // UN SEUL binding sur cette base, et il n'est jamais marque "remote".
      // Un second binding distant a ete injecte ici une fois par
      // l'auto-provisionnement de `wrangler dev` : le developpement local
      // ecrivait alors dans la base de production. S'il reapparait, c'est un
      // accident, pas une intention.
      "database_id": "bb8c92aa-66c2-4968-b58e-efe96e2fe51a"
    }
  ],

  // Un Durable Object SQLite par club. Un seul binding couvre un nombre
  // illimite de clubs : l'instance est adressee par nom (idFromName), creee
  // a la premiere utilisation. C'est ce qui rend l'inscription self-service
  // possible ; une base D1 par club exigerait un redeploiement a chaque club.
  "durable_objects": {
    "bindings": [
      { "name": "CLUB", "class_name": "ClubDatabase" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      // new_sqlite_classes, et non new_classes : indispensable pour obtenir le
      // backend SQLite plutot que le stockage cle-valeur historique.
      "new_sqlite_classes": ["ClubDatabase"]
    }
  ],

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "gymsaas" }
  ],

  "observability": { "enabled": true }
}
